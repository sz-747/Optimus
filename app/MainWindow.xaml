<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Optimus.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dashboard="using:Optimus.Dashboard"
    xmlns:sidebar="using:Optimus.Sidebar">

    <!-- Frontend-first dashboard. The terminal workspace host remains in the app codebase and is
         intentionally not instantiated until this visual shell is connected to live state. -->
    <Grid x:Name="Root">
        <dashboard:DashboardView x:Name="Dashboard" />
        <!-- Preserve the established terminal/session runtime behind the dashboard. It stays
             collapsed so its legacy split-tree chrome never competes with the new frontend. -->
        <sidebar:WorkspaceHost x:Name="Host" Visibility="Collapsed" />
    </Grid>
</Window>
