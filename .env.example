# Browser pairing secret. Use at least 24 random characters.
OPTIMUS_DASHBOARD_TOKEN=

# Separate desktop-only relay credential. Never reuse the dashboard token.
OPTIMUS_DESKTOP_TOKEN=

# Vercel Marketplace / Upstash Redis credentials.
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Tauri origins, comma-separated.
OPTIMUS_DESKTOP_ORIGINS=tauri://localhost,http://tauri.localhost

# Desktop bridge configuration.
OPTIMUS_RELAY_URL=
OPTIMUS_DEVICE_ID=primary
# Set to 1 only when relay configuration errors should prevent desktop startup.
OPTIMUS_RELAY_STRICT=0

# JSON arrays. Paths and executable commands stay local and are never sent to Vercel.
# OPTIMUS_RELAY_WORKSPACES=[{"id":"workspace-primary","label":"Optimus","repoRoot":"C:\\dev\\Optimus"}]
# Subscription profiles clear provider API keys so the CLI uses its signed-in session. API profiles
# name one approved credential environment variable; its value is injected only into that child.
# OPTIMUS_PROVIDER_PROFILES=[{"id":"codex-subscription","label":"Codex subscription","command":"codex","authMode":"subscription"},{"id":"codex-api","label":"Codex API","command":"codex","authMode":"api","credentialEnv":"OPENAI_API_KEY"}]
OPTIMUS_RELAY_WORKSPACES=
OPTIMUS_PROVIDER_PROFILES=
